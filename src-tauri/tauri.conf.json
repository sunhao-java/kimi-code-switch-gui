{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kimi Code Switch GUI",
  "version": "2.2.0",
  "identifier": "cn.crazycoder.kimi-code-switch-gui",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run tauri:dev:web",
    "beforeBuildCommand": "npm run tauri:build:web"
  },
  "app": {
    "windows": [
      {
        "title": "Kimi Code Switch GUI",
        "width": 1500,
        "height": 980,
        "minWidth": 1500,
        "minHeight": 980,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        },
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 Hulk Sun",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
