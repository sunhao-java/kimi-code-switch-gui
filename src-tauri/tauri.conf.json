{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kimi Code Switch GUI",
  "version": "1.1.9",
  "identifier": "cn.crazycoder.kimi-code-switch-gui",
  "build": {
    "frontendDist": "../dist-tauri",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run tauri:dev:web",
    "beforeBuildCommand": "npm run tauri:build:web"
  },
  "app": {
    "windows": [
      {
        "title": "Kimi Code Switch GUI",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 Hulk Sun"
  }
}
